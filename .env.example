# database
DB_URL=jdbc:mysql://localhost:3306/techshop
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# firebase storage
FIREBASE_BUCKET_NAME=your-bucket.firebasestorage.app
FIREBASE_STORAGE_PATH=your_storage_path
# absolute path to a firebase service account json file, kept outside the repo
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# smtp (gmail app password, not your account password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
